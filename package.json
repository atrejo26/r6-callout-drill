{
  "name": "r6-callout-drill",
  "productName": "R6 Callout Drill",
  "version": "1.1.3",
  "description": "Callout trainer for the Rainbow Six Siege Pro League map pool",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "dist:lite": "cp index.html launcher/ && cd launcher && GOOS=windows GOARCH=amd64 go build -trimpath -ldflags \"-s -w -H=windowsgui\" -o ../dist/R6-Callout-Drill-Lite.exe ."
  },
  "build": {
    "appId": "com.atrejo26.r6calloutdrill",
    "productName": "R6 Callout Drill",
    "files": [
      "desktop/**",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "R6-Callout-Drill-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "author": "atrejo26",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrejo26/r6-callout-drill.git"
  }
}
